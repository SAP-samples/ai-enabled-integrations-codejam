# All models available in AI Core can be found here: https://me.sap.com/notes/3437766
LITELLM_PROVIDER="sap"
MODEL_NAME="anthropic--claude-4.6-sonnet"

AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=https://------.hana.ondemand.com/oauth/token
AICORE_BASE_URL=https://------.hana.ondemand.com
AICORE_RESOURCE_GROUP=

IBD_TESTING=1
INVOKE_LIVE_MCP=1

CUSTOMER_REQUEST_MCP_URL=https://-----------.hana.ondemand.com/mcp/support-agent
SERVICE_LOCATOR_MCP_SERVER_URL=https://----------.integration.cloud.sap/service-locator-mcp-###

## Values from the Developer Hub subscription
SERVICE_LOCATOR_MCP_OAUTH_TOKEN_URL=https://--------.hana.ondemand.com/oauth/token
SERVICE_LOCATOR_MCP_OAUTH_CLIENT_ID=
SERVICE_LOCATOR_MCP_OAUTH_CLIENT_SECRET=

## Event-triggered mode (advanced event mesh) — OFF by default.
## Set ENABLE_EVENTING=1 to connect to the AEM broker over AMQP 1.0 and consume
## events. 0 or unset = plain A2A HTTP server only, no broker connection.
ENABLE_EVENTING=0

# AMQP 1.0 connection (from the AEM broker "Connect > AMQP" section).
# Used for BOTH consuming requests and publishing responses.
AEM_AMQP_HOST=<your-aem-instance>.messaging.solace.cloud
AEM_AMQP_PORT=5671
AEM_AMQP_USERNAME=solace-cloud-client
AEM_AMQP_PASSWORD=
# Durable queue to consume from. It must be subscribed to the request topic
# altura/customer-request-agent/request/v1 on the broker.
AEM_AMQP_QUEUE_NAME=customer-request-agent-requests
# Set to 0 to skip TLS peer verification (dev only).
AEM_AMQP_TLS_VERIFY=1

# Topic the agent publishes its response CloudEvent to (over the same AMQP connection).
AEM_RESPONSE_TOPIC=altura/customer-request-agent/response/v1
