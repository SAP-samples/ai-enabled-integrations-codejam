# AEM REST connection — copy this file to .env and fill in the values
# from your SAP Integration Suite, advanced event mesh service key.
# Server-side only (no VITE_ prefix — creds never exposed to browser).

# Basic auth credentials (from service key: "username" / "password")
AEM_USERNAME=your-username
AEM_PASSWORD=your-password

# AEM REST base URL (from service key: "uri")
AEM_BASE_URL=https://<your-aem-instance>.messaging.solace.cloud

# Topic to publish customer support requests to
AEM_TOPIC=altura/website/support/request/v1/submitted
